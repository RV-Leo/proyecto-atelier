# Copia este archivo como application-local.properties y agrega tu clave privada.
# Este perfil usa H2 local para que el backend de desarrollo no necesite PostgreSQL.
spring.datasource.url=jdbc:h2:file:./data/atelier;MODE=PostgreSQL
spring.datasource.username=sa
spring.datasource.password=
spring.datasource.driver-class-name=org.h2.Driver
spring.jpa.hibernate.ddl-auto=update
spring.flyway.enabled=false

spring.security.user.name=atelier
spring.security.user.password=atelier-dev

# Chat e imágenes usan una única API compatible con OpenAI.
atelier.ia.url=https://gen.pollinations.ai/v1
atelier.ia.api-key=PEGA_AQUI_TU_CLAVE_PRIVADA
atelier.ia.modelo-texto=openai/gpt-5.4-nano
atelier.ia.modelo-imagen=qwen/qwen-image-2.1
atelier.ia.timeout-segundos=240
