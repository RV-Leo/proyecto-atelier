# Configuración de ejemplo para desarrollo local de ATELIER (web).
# Copia este archivo como .env y ajusta los valores. No subas .env a Git.

DJANGO_SECRET_KEY=cambia-esta-clave-en-produccion
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Proveedor del asistente de diseño: 'demo' (simulado) o 'backend' (real, IA).
# Con 'backend' la web crea la prenda en la API y descarga las imágenes que
# genera el backend (Pollinations.ai o la IA local configurada allí).
ATELIER_AI_PROVEEDOR=demo
ATELIER_AI_URL_BASE=
# Imágenes por envío (1 por defecto: Pollinations gratuito permite 1 cada 45 s).
ATELIER_AI_MAX_IMAGENES=1

# API del backend (Spring Boot). La web no se conecta a PostgreSQL: lee las
# prendas y los materiales por HTTP desde aquí.
API_BASE_URL=http://localhost:8080/api/v1
API_USER=atelier
API_PASSWORD=atelier-dev
# Pollinations tarda ~12 s por imagen; 120 s evita cortar la descarga.
API_TIMEOUT=120
