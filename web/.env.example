# Configuración de ejemplo para desarrollo local de ATELIER (web).
# Copia este archivo como .env y ajusta los valores. No subas .env a Git.

DJANGO_SECRET_KEY=cambia-esta-clave-en-produccion
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Proveedor del asistente: 'backend' genera imágenes reales; 'demo' usa texturas.
ATELIER_AI_PROVEEDOR=backend
ATELIER_AI_URL_BASE=

# Chat y generación de imágenes a través del backend Spring Boot.
# La clave del proveedor de IA se configura solo en el backend, nunca aquí.
ATELIER_BACKEND_URL=http://localhost:8080
ATELIER_BACKEND_USER=atelier
ATELIER_BACKEND_PASSWORD=atelier-dev
ATELIER_BACKEND_TIMEOUT=90
ATELIER_BACKEND_IMAGE_TIMEOUT=240
