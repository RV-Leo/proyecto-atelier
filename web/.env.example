# Configuración de ejemplo para desarrollo local de ATELIER (web).
# Copia este archivo como .env y ajusta los valores. No subas .env a Git.

DJANGO_SECRET_KEY=cambia-esta-clave-en-produccion
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Proveedor del asistente de diseño: 'demo' (simulado) o 'qwen' (futuro).
ATELIER_AI_PROVEEDOR=demo
ATELIER_AI_URL_BASE=

# Chat con IA a través del backend Spring Boot (feature/ia-bridge-integration).
# Usa credenciales locales de desarrollo; en otros entornos configúralas fuera del repositorio.
ATELIER_BACKEND_URL=http://localhost:8080
ATELIER_BACKEND_USER=atelier
ATELIER_BACKEND_PASSWORD=atelier-dev
ATELIER_BACKEND_TIMEOUT=90
