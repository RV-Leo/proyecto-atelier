# Configuración de ejemplo para desarrollo local de ATELIER (web).
# Copia este archivo como .env y ajusta los valores. No subas .env a Git.

DJANGO_SECRET_KEY=cambia-esta-clave-en-produccion
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Proveedor del asistente web: 'demo' o 'backend'.
ATELIER_AI_PROVEEDOR=backend
ATELIER_BACKEND_URL=http://localhost:8080
ATELIER_BACKEND_USER=
ATELIER_BACKEND_PASSWORD=
ATELIER_BACKEND_TIMEOUT=90