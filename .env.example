# =====================================================================
#  Atelier - Variables de entorno (plantilla)
#  Copiar a .env y ajustar. NUNCA subir el .env real al repositorio.
# =====================================================================

# --- Backend / PostgreSQL (Spring Boot) ---
POSTGRES_URL=jdbc:postgresql://127.0.0.1:5432/atelier
POSTGRES_USER=atelier
POSTGRES_PASSWORD=atelier

# --- API REST (HTTP Basic) ---
API_USER=atelier
API_PASSWORD=atelier-dev

# --- Puente de IA (vacío = IA desactivada) ---
IA_URL=
IA_API_KEY=
IA_MODELO_TEXTO=Qwen3.6-35B-A3B
IA_MODELO_IMAGEN=Qwen-Image
IA_TIMEOUT_SEGUNDOS=120
IA_DIRECTORIO_IMAGENES=imagenes-diseno

# --- Aplicación web / Django ---
# Django NO usa SQLite: apunta a su propia base en PostgreSQL.
DJANGO_DB_NAME=atelier_web
DJANGO_DB_USER=atelier
DJANGO_DB_PASSWORD=atelier
DJANGO_DB_HOST=localhost
DJANGO_DB_PORT=5432

# URL de la API del backend (única fuente de datos de negocio)
API_BASE_URL=http://localhost:8080/api/v1
